[Desktop Entry]
Type=Application
# The unlocalized Name is the en-US string.
Name=Videos
# Name[] for every locale the app speaks — the same 28 as data/translations, and
# the same wording as each catalog's `app.name`, so the launcher and the window
# title never disagree. A test in i18n.rs fails if either half drifts.
# Two rules decide the key and the wording:
# - The key is a POSIX locale code, never the app's BCP-47 code: GLib reads
#   LC_ALL/LC_MESSAGES/LANG and tries `Name[de_DE.UTF-8]` → `Name[de_DE]` →
#   `Name[de]`, so `Name[de-DE]` is never matched (measured against this box).
#   Keys are language-only where one form serves the whole language, so de-AT and
#   pt-PT users get a translated name — the same language fallback select_locale
#   applies. `zh` needs the territory (the two written forms differ); a bare `zh`
#   carries the simplified form, which is also select_locale's fallback.
# - The wording is the msgid "Videos" in the catalogs this box ships
#   (xdg-user-dirs, kio6, tinysparql). Where they disagreed, the app name won
#   over the folder name: ar drops the definite article, he/pl follow GNOME's own
#   app names, ru/sv/nb the plain plural, vi drops xdg's archaic `Ảnh động`.
Name[ar]=فيديو
Name[bg]=Видео
Name[ca]=Vídeos
Name[de]=Videos
Name[el]=Βίντεο
Name[eo]=Videoj
Name[es]=Vídeos
Name[fa]=ویدیوها
Name[fi]=Videot
Name[fr]=Vidéos
Name[he]=סרטונים
Name[hu]=Videók
Name[id]=Video
Name[it]=Video
Name[ja]=ビデオ
Name[ko]=비디오
Name[nb]=Videoer
Name[nl]=Video's
Name[pl]=Filmy
Name[pt]=Vídeos
Name[ru]=Видео
Name[sv]=Videor
Name[tr]=Videolar
Name[uk]=Відео
Name[vi]=Video
Name[zh]=视频
Name[zh_CN]=视频
Name[zh_TW]=影片
GenericName=Media player
# GenericName and Comment follow the same key rules as Name[] (POSIX locale
# codes, language-only except where the written forms differ). Wording: the
# msgids this box ships where it has them — mpv's `Multimedia player` and
# `Play movies and songs` — and where it does not, the productive pattern of
# the players' catalogs it does ship (amberol's `Music Player`: de Medien-
# wiedergabe, fi Mediasoitin, eo Medialudilo after Muzikilo). pt is the one
# language here whose two forms genuinely differ (`multimédia`/`multimídia`),
# so it splits pt/pt_BR the way amberol's own entry does. A test in i18n.rs
# fails if any supported locale falls through to the unlocalized text.
GenericName[ar]=مُشَغِّل وسائط متعددة
GenericName[bg]=Медиен плейър
GenericName[ca]=Reproductor multimèdia
GenericName[de]=Medienwiedergabe
GenericName[el]=Αναπαραγωγή πολυμέσων
GenericName[eo]=Medialudilo
GenericName[es]=Reproductor multimedia
GenericName[fa]=پخش‌کنندهٔ رسانه
GenericName[fi]=Mediasoitin
GenericName[fr]=Lecteur multimédia
GenericName[he]=נגן מדיה
GenericName[hu]=Médialejátszó
GenericName[id]=Pemutar Media
GenericName[it]=Lettore multimediale
GenericName[ja]=マルチメディアプレイヤー
GenericName[ko]=미디어 플레이어
GenericName[nb]=Mediespiller
GenericName[nl]=Mediaspeler
GenericName[pl]=Odtwarzacz multimediów
GenericName[pt]=Reprodutor de multimédia
GenericName[pt_BR]=Reprodutor de multimídia
GenericName[ru]=Мультимедийный проигрыватель
GenericName[sv]=Mediaspelare
GenericName[tr]=Çoklu ortam oynatıcı
GenericName[uk]=Медіапрогравач
GenericName[vi]=Trình phát đa phương tiện
GenericName[zh]=多媒体播放器
GenericName[zh_CN]=多媒体播放器
GenericName[zh_TW]=多媒體播放器
Comment=Play videos and audio
